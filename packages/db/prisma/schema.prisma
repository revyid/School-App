generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: koneksi CLI di prisma.config.ts (MIGRATE_URL); runtime via adapter.
}

enum Role {
  SUPER_ADMIN
  ADMIN
  GURU
  SISWA
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPHA
}

enum AttendanceSource {
  SCAN
  MANUAL
  AUTO
}

enum CalendarKind {
  LIBUR
  EFEKTIF
}

enum TaskType {
  UPLOAD
  DIAGNOSTIC
  REGULAR
}

enum MaterialKind {
  TEXT
  FILE
  IMAGE
}

enum OutboxStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum LeaveKind {
  IZIN
  SAKIT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model School {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users           User[]
  classes         Class[]
  teacherClasses  TeacherClass[]
  studentProfiles StudentProfile[]
  auditLogs       AuditLog[]
  subjects        Subject[]
  settings        SchoolSettings?
  timetableSlots  TimetableSlot[]
  importBatches   ImportBatch[]
  attendance      AttendanceRecord[]
  calendar        AcademicCalendar[]
  studentQrs      StudentQr[]
  tasks           Task[]
  submissions     Submission[]
  taskMaterials   TaskMaterial[]
  notifications   Notification[]
  outbox          MessageOutbox[]
  leaveRequests   LeaveRequest[]
  captureSessions CaptureSession[]
  consents        ParentalConsent[]
  privacyPolicies PrivacyPolicy[]
}

model User {
  id                 String    @id @default(cuid())
  schoolId           String?
  school             School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role               Role
  email              String?
  nisn               String?
  passwordHash       String
  name               String
  isActive           Boolean   @default(true)
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  studentProfile     StudentProfile?
  homeroomOf         Class[]        @relation("Homeroom")
  taughtClasses      TeacherClass[] @relation("TeacherAssignments")
  timetableSlots     TimetableSlot[]
  attendance         AttendanceRecord[] @relation("StudentAttendance")
  editedAttendance   AttendanceRecord[] @relation("EditedAttendance")
  qrToken            StudentQr?
  createdTasks       Task[]         @relation("TaskAuthor")
  submissions        Submission[]   @relation("StudentSubmission")
  gradedSubmissions  Submission[]   @relation("SubmissionGrader")
  notifications      Notification[]
  leaveRequests      LeaveRequest[] @relation("LeaveStudent")
  reviewedLeaves     LeaveRequest[] @relation("LeaveReviewer")
  consents           ParentalConsent[]
  auditActions       AuditLog[]     @relation("Actor")
  @@unique([schoolId, email])
  @@unique([schoolId, nisn])
  @@index([schoolId, role])
}

model Class {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  gradeLevel        String?
  homeroomTeacherId String?
  homeroomTeacher   User?    @relation("Homeroom", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students          StudentProfile[]
  assignments       TeacherClass[]
  timetableSlots    TimetableSlot[]
  attendance        AttendanceRecord[]
  calendarOverrides AcademicCalendar[]
  tasks             Task[]
  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherClass {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User    @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String?
  @@unique([teacherId, classId])
  @@index([schoolId])
  @@index([classId])
}

model StudentProfile {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId     String?
  class       Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  parentPhone String?
  avatarUrl   String?
  bio         String?
  gender      String?   // "L" | "P"
  birthDate   DateTime?
  @@index([schoolId])
  @@index([classId])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([schoolId, createdAt])
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code     String?
  name     String
  slots    TimetableSlot[]
  tasks    Task[]
  @@unique([schoolId, name])
  @@index([schoolId])
}

model SchoolSettings {
  id                   String   @id @default(cuid())
  schoolId             String   @unique
  school               School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  portalName           String   @default("")
  logoUrl              String?
  startTime            String   @default("07:00")
  cutoffTime           String   @default("07:30")
  waDailyCap           Int      @default(200)
  waPerMinuteCap       Int      @default(10)
  ctaGtkUrl            String?
  ctaMuridUrl          String?
  studentRetentionDays Int      @default(90)
  photoRetentionDays   Int      @default(30)
  defaultPasswordMode  String   @default("random")
  updatedAt            DateTime @updatedAt
}

model TimetableSlot {
  id        String @id @default(cuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String?
  subjectRef  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName String   @default("")
  teacherId String?
  teacher   User?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  dayOfWeek Int
  startTime String
  endTime   String
  @@index([schoolId])
  @@index([classId, dayOfWeek])
}

model ImportBatch {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdById   String
  fileName      String
  status        String   @default("QUEUED")
  totalRows     Int      @default(0)
  processedRows Int      @default(0)
  okRows        Int      @default(0)
  errRows       Int      @default(0)
  errorReport   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([schoolId, createdAt])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  classId   String?
  class     Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  date      DateTime          @db.Date
  status    AttendanceStatus
  source    AttendanceSource  @default(SCAN)
  scannedAt DateTime?
  editedById String?
  editedBy  User?             @relation("EditedAttendance", fields: [editedById], references: [id], onDelete: SetNull)
  note      String?           @db.VarChar(280)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  @@unique([schoolId, studentId, date])
  @@index([schoolId, date])
  @@index([schoolId, classId, date])
}

model AcademicCalendar {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  kind      CalendarKind
  classId   String?
  class     Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  note      String?      @db.VarChar(280)
  createdAt DateTime     @default(now())
  // Keunikan ditegakkan via partial unique index di SQL (global vs per-kelas),
  // karena Postgres menganggap NULL berbeda dalam UNIQUE biasa.
  @@index([schoolId, date])
}

model StudentQr {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @unique
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  token     String   @unique
  // Disiapkan untuk rotasi token bertanda tangan (fase berikutnya):
  // version naik tiap rotasi, expiresAt membatasi masa berlaku token.
  version   Int      @default(1)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId])
}

model Task {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  authorId    String
  author      User     @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title       String   @db.VarChar(200)
  instruction String   @db.Text
  type        TaskType @default(REGULAR)
  deadline    DateTime?
  publishAt   DateTime @default(now())
  allowLate   Boolean  @default(false)
  isGroup     Boolean  @default(false)
  materials   TaskMaterial[]
  submissions Submission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([schoolId, classId, publishAt])
  @@index([schoolId, authorId])
}

model TaskMaterial {
  id       String       @id @default(cuid())
  schoolId String
  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind     MaterialKind @default(TEXT)
  text     String?      @db.Text
  fileName String?      @db.VarChar(255)
  mime     String?      @db.VarChar(128)
  size     Int?
  createdAt DateTime    @default(now())
  @@index([schoolId, taskId])
}

model Submission {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation("StudentSubmission", fields: [studentId], references: [id], onDelete: Cascade)
  text        String?   @db.Text
  link        String?   @db.VarChar(2048)
  fileName    String?   @db.VarChar(255)
  mime        String?   @db.VarChar(128)
  size        Int?
  submittedAt DateTime  @default(now())
  isLate      Boolean   @default(false)
  score       Int?
  feedback    String?   @db.VarChar(2000)
  gradedById  String?
  gradedBy    User?     @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt    DateTime?
  // Satu submission per (tugas, siswa): kirim ulang = update baris yang sama.
  @@unique([taskId, studentId])
  @@index([schoolId, taskId])
  @@index([schoolId, studentId])
}

model Notification {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(200)
  body      String   @db.VarChar(2000)
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([schoolId, userId, createdAt])
}

model MessageOutbox {
  id         String       @id @default(cuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  to         String       @db.VarChar(32)
  text       String       @db.VarChar(4000)
  status     OutboxStatus @default(QUEUED)
  attempts   Int          @default(0)
  lastError  String?      @db.VarChar(1000)
  // Idempotensi: kunci unik per pemicu (mis. alpha-<studentId>-<date>, h-1-<taskId>-<studentId>).
  dedupeKey  String?      @db.VarChar(128)
  scheduledAt DateTime    @default(now())
  sentAt     DateTime?
  createdAt  DateTime     @default(now())
  @@unique([schoolId, dedupeKey])
  @@index([schoolId, status, scheduledAt])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     User        @relation("LeaveStudent", fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  kind        LeaveKind
  description String      @db.VarChar(1000)
  // Foto live-capture (jalan server-side, bukan path mentah dari klien):
  studentPhoto String?    @db.VarChar(255)
  parentPhoto  String?    @db.VarChar(255)
  photographedAt DateTime?
  status      LeaveStatus @default(PENDING)
  reviewerId  String?
  reviewer    User?       @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote  String?     @db.VarChar(1000)
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // Satu pengajuan per (siswa, tanggal): ajukan ulang = update yang PENDING.
  @@unique([schoolId, studentId, date])
  @@index([schoolId, status, date])
  @@index([schoolId, studentId])
}

model CaptureSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  // Token opak server (bukan JWT): terikat user, sekali pakai, TTL pendek.
  token     String   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([schoolId, studentId])
}

model ParentalConsent {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @unique
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  consented Boolean  @default(false)
  consentedAt DateTime?
  // Admin penanda (bila ditandai manual, bukan via ortu).
  markedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId])
}

model PrivacyPolicy {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  updatedAt DateTime @updatedAt
}
