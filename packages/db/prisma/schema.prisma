generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: koneksi CLI di prisma.config.ts (MIGRATE_URL); runtime via adapter.
}

enum Role {
  SUPER_ADMIN
  ADMIN
  GURU
  SISWA
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPHA
}

enum AttendanceSource {
  SCAN
  MANUAL
  AUTO
}

enum CalendarKind {
  LIBUR
  EFEKTIF
}

enum TaskType {
  UPLOAD
  DIAGNOSTIC
  REGULAR
  KUIS
  PROYEK
  LATIHAN
}

// T1: status tugas — wizard membuat DRAFT, siswa hanya melihat PUBLISHED.
enum TaskStatus {
  DRAFT
  PUBLISHED
}

// T1: tipe file yang diizinkan per kategori unggahan.
enum UploadAccept {
  PDF
  IMAGE
  VIDEO
  DOC
}

enum MaterialKind {
  TEXT
  FILE
  IMAGE
  VIDEO
}

enum OutboxStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum LeaveKind {
  IZIN
  SAKIT
}

enum QType {
  MCQ
  SORTING
  SHORT
}

enum AssessKind {
  DIAGNOSTIC
  REGULAR
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model School {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users           User[]
  classes         Class[]
  studentProfiles StudentProfile[]
  auditLogs       AuditLog[]
  subjects        Subject[]
  settings        SchoolSettings?
  timetableSlots  TimetableSlot[]
  importBatches   ImportBatch[]
  attendance      AttendanceRecord[]
  calendar        AcademicCalendar[]
  studentQrs      StudentQr[]
  tasks           Task[]
  submissions     Submission[]
  taskMaterials   TaskMaterial[]
  notifications   Notification[]
  outbox          MessageOutbox[]
  leaveRequests   LeaveRequest[]
  captureSessions CaptureSession[]
  consents        ParentalConsent[]
  privacyPolicies PrivacyPolicy[]
  assessments     Assessment[]
  questions       Question[]
  assessQuestions AssessQuestion[]
  assessAttempts  AssessAttempt[]
  assessAnswers   AssessAnswer[]
  studyGroups     StudyGroup[]
  studyGroupMembers StudyGroupMember[]
  taskGroups      TaskGroup[]
  taskGroupMembers TaskGroupMember[]
  taskCategories  TaskCategory[]
  taskTargets     TaskTarget[]
  assessmentTargets AssessmentTarget[]
  submissionFiles SubmissionFile[]
  expLogs         ExpLog[]
  expBadges       ExpBadge[]
  announcements   Announcement[]
  collabThreads   CollabThread[]
  collabMessages  CollabMessage[]
  aiChatSessions  AiChatSession[]
  aiChatMessages  AiChatMessage[]
  pushSubscriptions PushSubscription[]
}

model User {
  id                 String    @id @default(cuid())
  schoolId           String?
  school             School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role               Role
  email              String?
  nisn               String?
  passwordHash       String
  name               String
  isActive           Boolean   @default(true)
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  studentProfile     StudentProfile?
  homeroomOf         Class[]        @relation("Homeroom")
  timetableSlots     TimetableSlot[]
  attendance         AttendanceRecord[] @relation("StudentAttendance")
  editedAttendance   AttendanceRecord[] @relation("EditedAttendance")
  qrToken            StudentQr?
  createdTasks       Task[]         @relation("TaskAuthor")
  submissions        Submission[]   @relation("StudentSubmission")
  submittedSubmissions Submission[] @relation("SubmissionSubmitter")
  gradedSubmissions  Submission[]   @relation("SubmissionGrader")
  notifications      Notification[]
  leaveRequests      LeaveRequest[] @relation("LeaveStudent")
  reviewedLeaves     LeaveRequest[] @relation("LeaveReviewer")
  collabMessages     CollabMessage[] @relation("CollabMessageAuthor")
  consents           ParentalConsent[]
  markedConsents     ParentalConsent[] @relation("ConsentMarker")
  assessAttempts     AssessAttempt[]  @relation("AssessStudent")
  gradedAttempts     AssessAttempt[]  @relation("AssessGrader")
  groupMemberships   StudyGroupMember[]
  taskGroupMemberships TaskGroupMember[]
  expLogs            ExpLog[]
  expBadges          ExpBadge[]
  collabThreads      CollabThread[] @relation("CollabSender")
  aiChatSessions     AiChatSession[]
  auditActions       AuditLog[]     @relation("Actor")
  pushSubscriptions  PushSubscription[]
  @@unique([schoolId, email])
  @@unique([schoolId, nisn])
  @@index([schoolId, role])
}

model Class {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  gradeLevel        String?
  homeroomTeacherId String?
  homeroomTeacher   User?    @relation("Homeroom", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students          StudentProfile[]
  timetableSlots    TimetableSlot[]
  attendance        AttendanceRecord[]
  calendarOverrides AcademicCalendar[]
  tasks             Task[]
  taskTargets       TaskTarget[]
  assessments       Assessment[]
  assessmentTargets AssessmentTarget[]
  @@unique([schoolId, name])
  @@index([schoolId])
}

model StudentProfile {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId     String?
  class       Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  parentPhone String?
  avatarUrl   String?
  bio         String?
  gender      String?   // "L" | "P"
  birthDate   DateTime?
  @@index([schoolId])
  @@index([classId])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([schoolId, createdAt])
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code     String?
  name     String
  slots    TimetableSlot[]
  tasks    Task[]
  assessments Assessment[]
  questions   Question[]
  @@unique([schoolId, name])
  @@index([schoolId])
}

model SchoolSettings {
  id                   String   @id @default(cuid())
  schoolId             String   @unique
  school               School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  portalName           String   @default("")
  logoUrl              String?
  startTime            String   @default("07:00")
  cutoffTime           String   @default("07:30")
  waDailyCap           Int      @default(200)
  waPerMinuteCap       Int      @default(10)
  ctaGtkUrl            String?
  ctaMuridUrl          String?
  studentRetentionDays Int      @default(90)
  photoRetentionDays   Int      @default(30)
  defaultPasswordMode  String   @default("random")
  aiChatEnabled        Boolean  @default(false)
  aiShareStudentData   Boolean  @default(false)
  // D7: zona waktu sekolah untuk format pengingat WA & tampilan tenggat.
  timezone             String   @default("Asia/Jakarta")
  // Template ucapan TTS saat scan absensi berhasil (variabel: {{name}}, {{class}}).
  ttsPhrase            String   @default("{{name}} sudah hadir")
  // Template ucapan TTS saat scan sudah dicatat/duplikat.
  ttsPhraseDup         String   @default("{{name}} sudah di catat")
  // Aturan EXP per sekolah (JSON: {submitOnTime, hadirHarian, streakBonus, ...}).
  expRules             Json?
  updatedAt            DateTime @updatedAt
}

model TimetableSlot {
  id        String @id @default(cuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String?
  subjectRef  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName String   @default("")
  teacherId String?
  teacher   User?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  dayOfWeek Int
  startTime String
  endTime   String
  @@index([schoolId])
  @@index([classId, dayOfWeek])
}

model ImportBatch {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdById   String
  fileName      String
  status        String   @default("QUEUED")
  totalRows     Int      @default(0)
  processedRows Int      @default(0)
  okRows        Int      @default(0)
  errRows       Int      @default(0)
  errorReport   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([schoolId, createdAt])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  classId   String?
  class     Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  date      DateTime          @db.Date
  status    AttendanceStatus
  source    AttendanceSource  @default(SCAN)
  scannedAt DateTime?
  editedById String?
  editedBy  User?             @relation("EditedAttendance", fields: [editedById], references: [id], onDelete: SetNull)
  note      String?           @db.VarChar(280)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  @@unique([schoolId, studentId, date])
  @@index([schoolId, date])
  @@index([schoolId, classId, date])
}

model AcademicCalendar {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  kind      CalendarKind
  classId   String?
  class     Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  note      String?      @db.VarChar(280)
  createdAt DateTime     @default(now())
  // Keunikan ditegakkan via partial unique index di SQL (global vs per-kelas),
  // karena Postgres menganggap NULL berbeda dalam UNIQUE biasa.
  @@index([schoolId, date])
}

model StudentQr {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @unique
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  token     String   @unique
  // Disiapkan untuk rotasi token bertanda tangan (fase berikutnya):
  // version naik tiap rotasi, expiresAt membatasi masa berlaku token.
  version   Int      @default(1)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId])
}

model Task {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  authorId    String
  author      User     @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title       String   @db.VarChar(200)
  instruction String   @db.Text
  type        TaskType @default(REGULAR)
  status      TaskStatus @default(PUBLISHED)
  deadline    DateTime?
  publishAt   DateTime @default(now())
  allowLate   Boolean  @default(false)
  isGroup     Boolean  @default(false)
  groupMin    Int      @default(2)
  groupMax    Int      @default(5)
  materials   TaskMaterial[]
  submissions Submission[]
  groups      TaskGroup[]
  categories  TaskCategory[]
  targets     TaskTarget[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([schoolId, classId, publishAt])
  @@index([schoolId, authorId])
}

// FASE 3 guru: tugas SHARED antar kelas. Induk (Task) menyimpan field shared
// (judul, instruksi, subject, type, kelompok, kategori); tiap baris TaskTarget
// menyimpan penugasan per kelas (deadline, publishAt, allowLate, status).
// Kolom lama Task.classId/deadline/publishAt/allowLate/status TETAP dipakai
// sebagai fallback (kelas utama) — JANGAN drop sebelum 2 rilis hijau.
model TaskTarget {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  status    TaskStatus @default(PUBLISHED)
  deadline  DateTime?
  publishAt DateTime @default(now())
  allowLate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([taskId, classId])
  @@index([schoolId, classId, publishAt])
  @@index([schoolId, taskId])
}

// T1: kategori unggahan per tugas (D3) — guru mendefinisikan 0..n kategori;
// tiap kategori maksimal 1 file per siswa/kelompok (kirim ulang = ganti).
model TaskCategory {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name        String  @db.VarChar(120)
  instruction String? @db.Text
  required    Boolean @default(false)
  accept      UploadAccept[]
  position    Int     @default(0)
  materials   TaskMaterial[]
  files       SubmissionFile[]
  @@index([schoolId, taskId, position])
}

model TaskMaterial {
  id       String       @id @default(cuid())
  schoolId String
  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind     MaterialKind @default(TEXT)
  text     String?      @db.Text
  fileName String?      @db.VarChar(255)
  mime     String?      @db.VarChar(128)
  size     Int?
  isMain    Boolean @default(false)
  isExample Boolean @default(false)
  categoryId String?
  category   TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  @@index([schoolId, taskId])
  @@index([categoryId])
}

model Submission {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation("StudentSubmission", fields: [studentId], references: [id], onDelete: Cascade)
  // Tugas kelompok (D1): satu pengumpulan per kelompok; pengumpul dicatat.
  groupId     String?
  submittedById String?
  submittedBy User?     @relation("SubmissionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  text        String?   @db.Text
  link        String?   @db.VarChar(2048)
  // Kolom lama (deprecated setelah backfill T1) — jangan dipakai kode baru.
  fileName    String?   @db.VarChar(255)
  mime        String?   @db.VarChar(128)
  size        Int?
  submittedAt DateTime  @default(now())
  isLate      Boolean   @default(false)
  score       Int?
  feedback    String?   @db.VarChar(2000)
  gradedById  String?
  gradedBy    User?     @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt    DateTime?
  files       SubmissionFile[]
  // Satu submission per (tugas, siswa): kirim ulang = update baris yang sama.
  // Untuk kelompok: unique parsial (taskId, groupId) WHERE groupId IS NOT NULL di SQL.
  @@unique([taskId, studentId])
  @@index([schoolId, taskId])
  @@index([schoolId, studentId])
}

// T1: file per kategori pengumpulan (categoryId null = file tunggal klasik).
model SubmissionFile {
  id            String  @id @default(cuid())
  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fileName      String  @db.VarChar(255)
  originalName  String  @db.VarChar(255)
  mime          String  @db.VarChar(128)
  size          Int
  createdAt     DateTime @default(now())
  // Unik per (submission, kategori) ditegakkan via partial index SQL di migrasi
  // (Postgres UNIQUE biasa memperlakukan NULL berbeda). Jangan pakai @@unique di sini.
  @@index([schoolId, submissionId])
}

model TaskGroup {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(100)
  createdById String
  leaderId    String
  members     TaskGroupMember[]
  createdAt   DateTime @default(now())
  @@unique([taskId, name])
  @@index([schoolId, taskId])
}

model TaskGroupMember {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  groupId   String
  group     TaskGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  taskId    String
  studentId String
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Satu siswa = satu grup per tugas.
  @@unique([taskId, studentId])
  @@index([schoolId, groupId])
}

model Notification {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(200)
  body      String   @db.VarChar(2000)
  // N5: tautan tujuan (mis. /siswa/tugas/<id>) + jenis pemicu.
  href      String?  @db.VarChar(300)
  kind      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([schoolId, userId, createdAt])
}

model MessageOutbox {
  id         String       @id @default(cuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  to         String       @db.VarChar(32)
  text       String       @db.VarChar(4000)
  status     OutboxStatus @default(QUEUED)
  attempts   Int          @default(0)
  lastError  String?      @db.VarChar(1000)
  // Idempotensi: kunci unik per pemicu (mis. alpha-<studentId>-<date>, h-1-<taskId>-<studentId>).
  dedupeKey  String?      @db.VarChar(128)
  scheduledAt DateTime    @default(now())
  sentAt     DateTime?
  createdAt  DateTime     @default(now())
  @@unique([schoolId, dedupeKey])
  @@index([schoolId, status, scheduledAt])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     User        @relation("LeaveStudent", fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  kind        LeaveKind
  description String      @db.VarChar(1000)
  // Foto live-capture (jalan server-side, bukan path mentah dari klien):
  studentPhoto String?    @db.VarChar(255)
  parentPhoto  String?    @db.VarChar(255)
  photographedAt DateTime?
  status      LeaveStatus @default(PENDING)
  reviewerId  String?
  reviewer    User?       @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote  String?     @db.VarChar(1000)
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // Satu pengajuan per (siswa, tanggal): ajukan ulang = update yang PENDING.
  @@unique([schoolId, studentId, date])
  @@index([schoolId, status, date])
  @@index([schoolId, studentId])
}

model CaptureSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  // Token opak server (bukan JWT): terikat user, sekali pakai, TTL pendek.
  token     String   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([schoolId, studentId])
}

model ParentalConsent {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @unique
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  consented Boolean  @default(false)
  consentedAt DateTime?
  // Admin penanda (bila ditandai manual, bukan via ortu).
  markedById String?
  markedBy   User?   @relation("ConsentMarker", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId])
}

model PrivacyPolicy {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  updatedAt DateTime @updatedAt
}

// ---------- Phase 7: Asesmen ----------
// KUNCI JAWABAN (correctIndex/correctOrder) TIDAK PERNAH dikirim ke klien.
// Acak urutan soal+opsi dan penilaian selalu server-side.

model Assessment {
  id          String     @id @default(cuid())
  schoolId    String
  school      School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  authorId    String
  kind        AssessKind @default(REGULAR)
  title       String     @db.VarChar(200)
  instruction String?    @db.Text
  durationMin Int?
  publishAt   DateTime   @default(now())
  deadline    DateTime?
  shuffleQ    Boolean    @default(true)
  shuffleOpt  Boolean    @default(true)
  showChart   Boolean    @default(true)
  isPublic    Boolean    @default(true)
  questions   AssessQuestion[]
  attempts    AssessAttempt[]
  groups      StudyGroup[]
  targets     AssessmentTarget[]
  memberLinks StudyGroupMember[] @relation("MemberAssessment")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId, classId, publishAt])
  @@index([schoolId, authorId])
}

// FASE 3 guru: asesmen SHARED antar kelas (pola sama dengan TaskTarget).
// Kolom lama Assessment.classId/deadline/publishAt TETAP sebagai fallback.
model AssessmentTarget {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  deadline  DateTime?
  publishAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([assessmentId, classId])
  @@index([schoolId, classId, publishAt])
  @@index([schoolId, assessmentId])
}

// Bank soal milik guru per mapel: Question + snapshot AssessQuestion per asesmen.
// Alasan snapshot: bank boleh diedit guru tanpa merusak asesmen yang sudah jalan.
model Question {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  authorId  String
  type      QType    @default(MCQ)
  stem      String     @db.Text
  imageName String?    @db.VarChar(255)
  videoName String?    @db.VarChar(255)
  options   String[]   @db.Text
  // A4: jawaban benar SHORT (kunci — hanya server-side).
  shortAnswers String[] @default([])
  // KUNCI: hanya dibaca server-side (route attempt + grading + analisis).
  correctIndex Int?
  correctOrder Int[]  @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId, subjectId])
  @@index([schoolId, authorId])
}

model AssessQuestion {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type         QType      @default(MCQ)
  stem         String     @db.Text
  imageName    String?    @db.VarChar(255)
  videoName    String?    @db.VarChar(255)
  options      String[]   @db.Text
  // A4: kunci jawaban SHORT (server-side saja).
  shortAnswers String[]   @default([])
  points       Int        @default(10)
  position     Int        @default(0)
  // KUNCI snapshot: server-side saja.
  correctIndex Int?
  correctOrder Int[]      @default([])
  answers      AssessAnswer[]
  @@index([schoolId, assessmentId, position])
}

model AssessAttempt {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation("AssessStudent", fields: [studentId], references: [id], onDelete: Cascade)
  // Urutan acak per attempt (seed tersimpan; jawaban dinilai via pemetaan server).
  qOrder       String[]   @default([])
  optOrders    Json?
  startedAt    DateTime   @default(now())
  submittedAt  DateTime?
  score        Int?
  maxScore     Int?
  gradedById   String?
  gradedBy     User?      @relation("AssessGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  answers      AssessAnswer[]
  // Satu attempt per (asesmen, siswa): kirim ulang = update attempt yang sama.
  @@unique([assessmentId, studentId])
  @@index([schoolId, assessmentId])
  @@index([schoolId, studentId])
}

model AssessAnswer {
  id         String         @id @default(cuid())
  schoolId   String
  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attemptId  String
  attempt    AssessAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   AssessQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Jawaban dalam KOORDINAT ASLI (dipetakan server dari koordinat acak klien).
  pickedIndex Int?
  pickedOrder Int[]          @default([])
  isCorrect   Boolean?
  points      Int?
  @@unique([attemptId, questionId])
  @@index([schoolId, attemptId])
  @@index([schoolId, questionId])
}

// Grup per asesmen (isGroup di Task tidak dipakai untuk asesmen).
// Nilai selalu per siswa (attempt masing-masing); grup hanya pengelompokan.
model StudyGroup {
  id           String             @id @default(cuid())
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  name         String             @db.VarChar(100)
  members      StudyGroupMember[]
  @@unique([assessmentId, name])
  @@index([schoolId, assessmentId])
}

model StudyGroupMember {
  id        String     @id @default(cuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Satu siswa = satu grup per asesmen.
  @@unique([assessmentId, studentId])
  assessmentId String
  assessment   Assessment @relation("MemberAssessment", fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([schoolId, groupId])
}

// ---------- Phase 8 (parsial di sini: ExpLog; portal lain di Fase 8) ----------

model ExpLog {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points    Int
  reason    String   @db.VarChar(200)
  // Kunci idempotensi per pemicu (mis. submit-<submissionId>, hadir-<recordId>).
  dedupeKey String?  @db.VarChar(128)
  createdAt DateTime @default(now())
  @@unique([schoolId, dedupeKey])
  @@index([schoolId, studentId, createdAt])
}

// ---------- Phase 8: Portal ----------

model ExpBadge {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Nama badge stabil (mis. streak-7, rajin-30, nilai-100).
  name      String   @db.VarChar(100)
  awardedAt DateTime @default(now())
  // Satu badge per (siswa, nama).
  @@unique([studentId, name])
  @@index([schoolId, studentId])
}

model Announcement {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorId  String
  title     String   @db.VarChar(200)
  body      String   @db.Text
  // Target: ALL | GURU | SISWA | kelas:<classId>.
  target    String   @default("ALL") @db.VarChar(64)
  publishAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([schoolId, publishAt])
  @@index([schoolId, target])
}

// Inbox kolaborasi. senderId:null = pesan anonim publik (tanpa login) sehingga
// tidak ada pengirim untuk di-reveal; senderId non-null + anonymous:true = kiriman
// pengguna login yang identitasnya disembunyikan dari guru (admin boleh reveal,
// wajib audit COLLAB.REVEAL). Lampiran via TaskFiles-like.
model CollabThread {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?    @relation("CollabSender", fields: [senderId], references: [id], onDelete: Restrict)
  subject   String   @db.VarChar(200)
  anonymous Boolean  @default(false)
  // Guru tujuan (multi-select disimpan sebagai baris recipient).
  recipients String[] @db.Text
  revealedAt DateTime?
  revealedById String?
  messages   CollabMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId, senderId])
}

model CollabMessage {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  threadId  String
  thread    CollabThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?        @relation("CollabMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String       @db.Text
  fileName  String?      @db.VarChar(255)
  createdAt DateTime     @default(now())
  @@index([schoolId, threadId, createdAt])
}

// Web Push subscriptions per user/device, tenant-scoped for RLS.
model PushSubscription {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String   @db.Text
  endpointHash String   @db.VarChar(64)  // sha256 hex dari endpoint, untuk unique check
  p256dh       String   @db.Text
  auth         String   @db.VarChar(500)
  userAgent    String?  @db.VarChar(300)
  createdAt    DateTime @default(now())
  @@unique([userId, endpointHash])
  @@index([schoolId])
  @@index([userId])
}

// Riwayat chat AI per user (persistensi). Tamu tidak disimpan (tanpa userId).
// Batas: max 50 pesan per user (pruning FIFO di route). Role user HANYA miliknya.
model AiChatSession {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  @@unique([schoolId, userId])
  @@index([schoolId, userId])
}

model AiChatMessage {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String        @db.VarChar(16) // "user" | "assistant"
  content   String        @db.Text
  createdAt DateTime      @default(now())
  @@index([schoolId, sessionId, createdAt])
}
