HOSTNAME=127.0.0.1
DATABASE_URL=postgresql://app_user:***@127.0.0.1:5432/smsdb
JWT_SECRET=ganti-minimal-32-char
REDIS_URL=redis://127.0.0.1:6379
# Sesi Baileys per sekolah (volume wa-sessions). WAJIB sama dengan web.
INTERNAL_TOKEN=ganti-acak-panjang
WA_SESSIONS_ROOT=/data/wa-sessions
# WA_FAKE=1 HANYA untuk tes otomatis (FakeProvider). Jangan set di produksi.
