# runtime web = app_user. TANPA SYSTEM_URL / password owner.
HOSTNAME=127.0.0.1
DATABASE_URL=postgresql://app_user:***@127.0.0.1:5432/lacakedudb
ROOT_DATABASE_URL=postgresql://app_root:change-me-in-production@lacakedu-postgres:5432/lacakedudb
JWT_SECRET=ganti-minimal-32-char
APEX_DOMAIN=domainmu.id
REDIS_URL=redis://127.0.0.1:6379
# Proxy server-side ke worker loopback (/api/wa/status). WAJIB sama dengan worker.
INTERNAL_TOKEN=ganti-acak-panjang
WORKER_PORT=3001
# AI chat siswa via router OpenAI-compatible (jangan commit key asli).
AI_ROUTER_BASE=https://9router.revy.my.id/v1
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=kc/cohere/north-mini-code:free
# Fitur AI selalu nonaktif kecuali diaktifkan eksplisit di deployment.
AI_CHAT_ENABLED=false
# Konteks data siswa tidak pernah dikirim ke model eksternal kecuali kedua sisi opt-in.
AI_ALLOW_STUDENT_DATA_SHARING=false
