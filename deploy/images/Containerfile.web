# syntax=docker/dockerfile:1
# Build web (Next.js standalone) — 2 tahap supaya image runtime kecil & build cepat.
#
# Kenapa manifest di-COPY dulu: kalau source di-COPY dulu, setiap perubahan kode
# membatalkan layer `pnpm install` -> install ulang tiap build (2-3 menit).
# Dengan urutan ini, install hanya diulang bila package.json/lockfile berubah.
#
# Image runtime hanya berisi hasil standalone (node_modules的生产 + .next),
# bukan seluruh repo -> jauh lebih kecil & jauh lebih cepat di-push ke VPS.

FROM docker.io/library/node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@10.18.0 --activate
WORKDIR /app

# 1) Manifest workspace (layer cache-friendly).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/cli/package.json packages/cli/
RUN --mount=type=cache,target=/pnpm/store pnpm install --frozen-lockfile

# 2) Sumber kode.
COPY . .
RUN MIGRATE_URL=postgresql://dummy:***@localhost:5432/dummy pnpm --filter @lacakedu/db exec prisma generate
RUN pnpm --filter @lacakedu/shared run build
RUN pnpm --filter @lacakedu/db run build
# Rewrite /socket.io dibekukan saat build, jadi port worker harus benar di sini.
ENV WORKER_PORT=3001
RUN pnpm --filter @lacakedu/web exec next build
# Salin aset statis + public ke standalone:
RUN cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static && \
    cp -r apps/web/public apps/web/.next/standalone/apps/web/public

# ---------------------------------------------------------------- runtime image
FROM docker.io/library/node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
