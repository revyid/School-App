[Unit]
Description=lacakedu web (Next.js standalone)
After=lacakedu-postgres.service lacakedu-redis.service
Requires=lacakedu-postgres.service lacakedu-redis.service

[Container]
Image=localhost/lacakedu-web:latest
ContainerName=lacakedu-web
Network=lacakedu.network
User=node
EnvironmentFile=%h/lacakedu/web.env
Volume=uploads.volume:/data/uploads:Z,U
HealthCmd=CMD-SHELL node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
HealthInterval=30s

[Service]
Restart=always
MemoryMax=1G

[Install]
WantedBy=default.target
