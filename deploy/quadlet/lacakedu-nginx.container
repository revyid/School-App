[Unit]
Description=lacakedu nginx (HTTP origin untuk cloudflared tunnel; tidak ada port publik)
After=lacakedu-web.service lacakedu-worker.service

[Container]
Image=docker.io/library/nginx:stable-alpine
ContainerName=lacakedu-nginx
Network=lacakedu.network
PublishPort=127.0.0.1:8080:80
Volume=%h/lacakedu/nginx/nginx.conf:/etc/nginx/nginx.conf:ro,Z
HealthCmd=CMD-SHELL wget -qO- http://127.0.0.1/healthz | grep -q ok
HealthInterval=30s

[Service]
Restart=always
MemoryMax=128M

[Install]
WantedBy=default.target
